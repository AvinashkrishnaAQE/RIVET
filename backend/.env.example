# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
# Reverse proxies in front of the app (0 = none; set 1 behind ngrok or a reverse proxy).
TRUST_PROXY=0

# --- Database (Postgres) ---------------------------------------------------
# Direct connection: used by `npm run migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Optional pooled connection: used by the running app when set (Neon: the -pooler host).
DATABASE_URL_POOLED=
# Connection timeout in ms (default is 30000ms; recommended >= 30000ms for serverless cold starts)
DB_CONNECTION_TIMEOUT_MS=30000

# --- Auth ------------------------------------------------------------------
# Required, >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (seconds) and refresh-session lifetimes (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Browser / CORS --------------------------------------------------------
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3133
# Base URL used in password-reset links.
FRONTEND_URL=http://localhost:3133
# Cookies: leave defaults when frontend and API share a registrable domain.
# Set COOKIE_SAME_SITE=none (requires HTTPS) only for cross-site deployments.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# --- Webhooks (GitHub) -----------------------------------------------------
# Shared secret configured in GitHub webhook settings (>= 16 chars).
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=osDn75w08lDAsDXQzNFxiyO4bF7qA+nxPwvW9w6CZAM=
WEBHOOK_BODY_LIMIT=5mb
