# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
# Reverse proxies in front of the app (0 = none). Needed for correct client IPs.
TRUST_PROXY=0

# --- Database (Postgres) ---------------------------------------------------
# Direct connection: used by `npm run migrate`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Optional pooled connection: used by the running app when set (Neon: the -pooler host).
DATABASE_URL_POOLED=

# --- Auth ------------------------------------------------------------------
# Required, >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime (seconds) and refresh-session lifetimes (days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Browser / CORS --------------------------------------------------------
# Comma-separated origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:3000
# Base URL used in password-reset links.
FRONTEND_URL=http://localhost:3000
# Cookies: leave defaults when frontend and API share a registrable domain.
# Set COOKIE_SAME_SITE=none (requires HTTPS) only for cross-site deployments.
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
