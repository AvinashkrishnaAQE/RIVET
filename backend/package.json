{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js backend",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "dev": "node --watch --env-file-if-exists=.env.local src/server.js",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
